# Variante para rodar como backend HTTP comum (fora do Lambda), ex: EC2, VPS, Docker Compose.
FROM python:3.12-slim

WORKDIR /app

COPY translator.py convert.py server.py requirements-server.txt ./

# Mesma ideia do Dockerfile do Lambda: torch só existe durante a conversão dos modelos,
# depois é removido. O resultado (modelos CT2 em /opt/ct2) é idêntico nas duas imagens.
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-server.txt \
 && python3 convert.py \
 && pip uninstall -y torch sympy networkx mpmath \
 && rm -rf /root/.cache /tmp/* /var/cache/*

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
